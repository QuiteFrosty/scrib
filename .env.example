# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 — where lecture audio is actually stored.
# Dashboard → R2 → your bucket → Manage API tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# OpenAI — used for Whisper transcription
OPENAI_API_KEY=

# Anthropic — used to generate summaries, key points, and flashcards
ANTHROPIC_API_KEY=
